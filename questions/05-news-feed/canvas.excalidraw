      "version": 707,
      "versionNonce": 1844765969,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "1242i-fA0kuYSo_GGFEUB",
          "type": "arrow"
        },
        {
          "id": "LScfNLSsMlboA85IMbWGc",
