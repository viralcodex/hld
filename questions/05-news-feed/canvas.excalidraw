      "updated": 1791633773934,
      "link": null,
      "locked": false,
      "text": "write service batches comments and replies\nand then updates in intervals to the DB\nto prevent massive spike in queries \nfor a viral post",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "write service batches comments and replies\nand then updates in intervals to the DB\nto prevent massive spike in queries \nfor a viral post",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZySpeHJ0CZoowInc3uJqj",
      "type": "text",
      "x": -546.795175903753,
      "y": -86.80756418747882,
      "width": 425.01971435546875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 1288297329,
      "version": 482,
      "versionNonce": 150674801,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791634129947,
      "link": null,
      "locked": false,
      "text": "Estimates:\n200 DAU = 23.1k U/s\n90% of users have less than 1k \nfollowers and post less than 3 times a day.\n90% of its following only reads posts.\na celeb = >= 100k followers.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Estimates:\n200 DAU = 23.1k U/s\n90% of users have less than 1k \nfollowers and post less than 3 times a day.\n90% of its following only reads posts.\na celeb = >= 100k followers.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
