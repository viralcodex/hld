    {
      "id": "M5535RBRm-Cwet_Ks5f58",
      "type": "text",
      "x": 810.6938353406535,
      "y": 433.14984491866403,
      "width": 618.5321044921875,
      "height": 330.18295393478854,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
