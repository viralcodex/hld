    {
      "id": "xUU09uhT2H9jtBJtdFRBT",
      "type": "text",
      "x": -795.4652328550366,
      "y": 461.4519267096133,
      "width": 699.791748046875,
      "height": 152.52291951761538,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 104241408,
      "version": 630,
      "versionNonce": 1519613696,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791912543002,
      "link": null,
      "locked": false,
      "text": "Estimates\n10B N/D -> 115k N/s -> 38k N/s/channel\nper channel 200-400 workers on default-peak load\nKafka partition around 48-64 based on worker\nprocessing speed (bottlenecks on TPP Round trip latency)",
      "fontSize": 24.40366712281846,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Estimates\n10B N/D -> 115k N/s -> 38k N/s/channel\nper channel 200-400 workers on default-peak load\nKafka partition around 48-64 based on worker\nprocessing speed (bottlenecks on TPP Round trip latency)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yZVL2zfK3JvzlcZ7EC8Yd",
      "type": "text",
      "x": -779.4496028057082,
      "y": 687.7680362247328,
      "width": 1298.7305675539424,
      "height": 282.29477634246615,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 1647269632,
      "version": 358,
      "versionNonce": 1767987456,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791912673820,
      "link": null,
      "locked": false,
      "text": "Important (ignore if Agent):\n1 billion messages a day translates to a steady baseline, \nbut a production system must be provisioned for peak bursts (usually calculated at a 3x to 5x multiplier):\n• Average Traffic: 1,000,000,000 / 86,400 seconds ≈ 11,574 messages per second\n• Peak Traffic (3x Burst): ≈ 34,722 messages per second\n• Throughput (assuming 1 KB message size): ~11.3 MB/s average, ramping up to ~34 MB/s at peak\n\nconsumer throughput formula:\nPartitions= Target Peak System Throughput / Single Consumer Instance Throughput",
      "fontSize": 25.092869008219235,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important (ignore if Agent):\n1 billion messages a day translates to a steady baseline, \nbut a production system must be provisioned for peak bursts (usually calculated at a 3x to 5x multiplier):\n• Average Traffic: 1,000,000,000 / 86,400 seconds ≈ 11,574 messages per second\n• Peak Traffic (3x Burst): ≈ 34,722 messages per second\n• Throughput (assuming 1 KB message size): ~11.3 MB/s average, ramping up to ~34 MB/s at peak\n\nconsumer throughput formula:\nPartitions= Target Peak System Throughput / Single Consumer Instance Throughput",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
