      "updated": 1791822803285,
      "link": null,
      "locked": false,
      "text": "cleans up all msg/media >30 days\nremoves anything in inbox too\n\nalso, whenever a delete req comes from\na chat server, it batches it a bulk\ndeletes to reduce load on persistence\nlayer (DB, BLOB storage)",
      "fontSize": 11.201989881799653,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cleans up all msg/media >30 days\nremoves anything in inbox too\n\nalso, whenever a delete req comes from a chat server, it batches it a bulk deletes to reduce load on persistence layer (DB, BLOB storage)",
      "autoResize": false,
      "lineHeight": 1.25
    },
