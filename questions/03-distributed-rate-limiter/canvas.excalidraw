    },
    {
      "id": "Ynu2TRYNXR-tUlNO6KUCh",
      "type": "text",
      "x": 594.8111898636539,
      "y": 1263.76031015267,
      "width": 591.9595336914062,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1784680339,
      "version": 297,
      "versionNonce": 1169779677,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791543720082,
      "link": null,
      "locked": false,
      "text": "*reduce latency:\n    - connection pooling \n    - Gateway and RL and Redis cluster should be geo-close \n      as much as possible to reduce altency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*reduce latency:\n    - connection pooling \n    - Gateway and RL and Redis cluster should be geo-close \n      as much as possible to reduce altency",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y8RrD2yMgLoVUPAsS4hq9",
      "type": "text",
      "x": 1586.2930831428075,
      "y": 446.35789516830476,
      "width": 537.919677734375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 136040797,
      "version": 883,
      "versionNonce": 1948389619,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791544508453,
      "link": null,
      "locked": false,
      "text": "RL nodes are sticky in nature so each client \nfor its entirety, so we can have a local + redis sync.\nbut if sticky sessions are problematic to deal with,\nlocal state goes off & redis is the source of truth for\nall RL nodes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RL nodes are sticky in nature so each client \nfor its entirety, so we can have a local + redis sync.\nbut if sticky sessions are problematic to deal with,\nlocal state goes off & redis is the source of truth for\nall RL nodes.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
