    {
      "id": "zJnGbdvXhIVHhV02WtKw8",
      "type": "text",
      "x": 595.817175911349,
      "y": 1126.8519269763683,
      "width": 653.3395385742188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
