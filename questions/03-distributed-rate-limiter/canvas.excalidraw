      "seed": 2128243207,
      "version": 402,
      "versionNonce": 1404990131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791544327929,
      "link": null,
      "locked": false,
      "text": "Note: If The RL node having the counter for that user is down\nand until a new node is created and is ready to serve, those users\nwill get fail-closed behaviour like 503/429 to prevent hammering of\nrequests. same behaviour for redis nodes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: If The RL node having the counter for that user is down\nand until a new node is created and is ready to serve, those users\nwill get fail-closed behaviour like 503/429 to prevent hammering of\nrequests. same behaviour for redis nodes",
      "autoResize": true,
      "lineHeight": 1.25
    },
