      "versionNonce": 1554518749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791543768098,
      "link": null,
      "locked": false,
      "text": "Sharded by Key (userId)\nCounters updated by local RL nodes at intervals\nWhenever a RL node goes down, a new one can take its place\nand bring itself uptodate using the Redis state for those \nusers.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sharded by Key (userId)\nCounters updated by local RL nodes at intervals\nWhenever a RL node goes down, a new one can take its place\nand bring itself uptodate using the Redis state for those \nusers.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
