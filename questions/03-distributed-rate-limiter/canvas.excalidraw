    {
      "id": "_qG_eyQZ6vY1tmPbPi3H7",
      "type": "text",
      "x": 1935.2991229541926,
      "y": 633.6234233699124,
      "width": 308.28406761235874,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1521659369,
      "version": 614,
      "versionNonce": 217591347,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "knsd_ZtyjM3V374bZ32rt",
          "type": "arrow"
        }
      ],
      "updated": 1791543572353,
      "link": null,
      "locked": false,
      "text": "This file can be put\nin a centralised Zookeeper\n(etcd) instance and copied by\neach RL node.\nso whenever a change happens\nglobally\nwe can push new changes to\nthese nodes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This file can be put\nin a centralised Zookeeper (etcd) instance and copied by each RL node.\nso whenever a change happens globally\nwe can push new changes to these nodes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "QOqMWf7lQjho9dpvq5JsW",
      "type": "rectangle",
