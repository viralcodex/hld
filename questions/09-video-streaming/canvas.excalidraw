      "isDeleted": false,
      "boundElements": null,
      "updated": 1792235301351,
      "link": null,
      "locked": false,
      "text": "Estimates\n2B U\n1B hours/D -> 110k hours/s\n500 hours/m -> 8 hours/s upload\n1 video = 400MB (1080p) avg\n15min/video -> 32 videos/s upload\n-> 32 * 86400 = 3M videos/d\n3M * 0.4GB -> 120 TB/d",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Estimates\n2B U\n1B hours/D -> 110k hours/s\n500 hours/m -> 8 hours/s upload\n1 video = 400MB (1080p) avg\n15min/video -> 32 videos/s upload\n-> 32 * 86400 = 3M videos/d\n3M * 0.4GB -> 120 TB/d",
      "autoResize": true,
      "lineHeight": 1.25
    },
