    {
      "id": "E0g8JaRjgXgfwR0SAgGAL",
      "type": "text",
      "x": 422.9343310067054,
      "y": -321.4030730878939,
      "width": 305.48491251421524,
      "height": 113.74449310230742,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
