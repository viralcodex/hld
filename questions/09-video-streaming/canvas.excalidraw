      "link": null,
      "locked": false,
      "text": "based on HLS/DASH client\nrequest chunk resolution based\non network strength through\nthe video manifest sent by\nvideo svc  (adaptive streaming)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "based on HLS/DASH client request chunk resolution based on network strength through the video manifest sent by video svc  (adaptive streaming)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "36WXdy1EbGtFRFYkTCz91",
      "type": "text",
      "x": -354.14855918495175,
      "y": 593.080465138873,
      "width": 216.57784789880935,
      "height": 96.56914966978228,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 600321870,
      "version": 1436,
      "versionNonce": 1618211854,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792234183001,
      "link": null,
      "locked": false,
      "text": "CDN serves directly if it has the\nchunk files, if not, it fetches\ndirectly from the blob storage and\nthen saves it for later requests \n(that's why first loads are\nslower)",
      "fontSize": 12.875886622637637,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CDN serves directly if it has the chunk files, if not, it fetches directly from the blob storage and then saves it for later requests \n(that's why first loads are slower)",
      "autoResize": false,
      "lineHeight": 1.25
    },
