      "isDeleted": false,
      "boundElements": null,
      "updated": 1792234809970,
      "link": null,
      "locked": false,
      "text": "metrics\n- videoid PK\n- views\n- likes\n- dislikes\n- comments\n- replies",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "metrics\n- videoid PK\n- views\n- likes\n- dislikes\n- comments\n- replies",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QYRWFqXTFlG8cknM9nkjh",
      "type": "text",
      "x": 897.3407706048266,
      "y": 947.8529653279473,
      "width": 308.5567894045063,
      "height": 89.30881022873533,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 28124882,
      "version": 651,
      "versionNonce": 1691436690,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792234650671,
      "link": null,
      "locked": false,
      "text": "Spark/Flink process these events, dedupe\nthem based on video svc sessionId, IP and\nother data & then update it in batches\n(like 10K views or after 2 minutes)\nto prevent spikes on a viral video",
      "fontSize": 14.289409636597652,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spark/Flink process these events, dedupe them based on video svc sessionId, IP and other data & then update it in batches (like 10K views or after 2 minutes)\nto prevent spikes on a viral video",
      "autoResize": false,
      "lineHeight": 1.25
    },
