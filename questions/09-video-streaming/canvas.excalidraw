      "index": "b0S",
      "roundness": null,
      "seed": 93194386,
      "version": 961,
      "versionNonce": 589373394,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792233534322,
      "link": null,
      "locked": false,
      "text": "stores diff resolutions for each video in chunks.\nan example storage design:\n/video-1/chunk1[], chunk2[], ...., chunk n[]\n/video-2/chunk1[], chunk2[],...., chunk n[]\n[each chunk has a subdir for each resolution\nso you can get a chunk for a resolution as:\nvideo/chunk<n>/<quality>",
      "fontSize": 12.9993706402637,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "stores diff resolutions for each video in chunks.\nan example storage design:\n/video-1/chunk1[], chunk2[], ...., chunk n[]\n/video-2/chunk1[], chunk2[],...., chunk n[]\n[each chunk has a subdir for each resolution\nso you can get a chunk for a resolution as:\nvideo/chunk<n>/<quality>",
      "autoResize": true,
      "lineHeight": 1.25
    },
