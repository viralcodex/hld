      "index": "b07",
      "roundness": null,
      "seed": 1471478961,
      "version": 379,
      "versionNonce": 1000970335,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791559888094,
      "link": null,
      "locked": false,
      "text": "each node maintains\na master-slave\narchitecture internally\nto prevent data loss on\nnode going down unexpectedly",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "each node maintains\na master-slave\narchitecture internally\nto prevent data loss on\nnode going down unexpectedly",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EWsOROPWxQuosf0u-LH2l",
      "type": "text",
      "x": -1488.9500071470693,
      "y": 407.72705982251324,
      "width": 428.827199748843,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 2131998559,
      "version": 418,
      "versionNonce": 2013757695,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791548719526,
      "link": null,
      "locked": false,
      "text": "data sharding happens\nbased on the\nPK or any other field\nthat needs distribution",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "data sharding happens based on the\nPK or any other field that needs distribution",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "oy4ilLE1DPe5aD5GPKVWR",
      "type": "text",
      "x": -498.07338984479065,
      "y": 274.85995277324196,
      "width": 425.99523945705755,
      "height": 106.21525750135523,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 1510378847,
      "version": 574,
      "versionNonce": 67799153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791548805438,
      "link": null,
      "locked": false,
      "text": "Eviction based on LRU + TTL.\nLRU happens at limit and TTL\ncan happen anytime.",
      "fontSize": 28.32406866702806,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Eviction based on LRU + TTL.\nLRU happens at limit and TTL can happen anytime.",
      "autoResize": false,
      "lineHeight": 1.25
    },
