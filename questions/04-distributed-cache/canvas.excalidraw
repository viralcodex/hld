      "seed": 1127646641,
      "version": 622,
      "versionNonce": 269851761,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791547306104,
      "link": null,
      "locked": false,
      "text": "Each node works in a Master-slave architecture\nwhere master writes the data to itself and slaves replicate it\nSo if master goes down, any slave can be promoted to the master\n(There can be minor inconsistencies if master goes down before \nthe data is replicated which is very rare but worth calling out)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each node works in a Master-slave architecture\nwhere master writes the data to itself and slaves replicate it\nSo if master goes down, any slave can be promoted to the master\n(There can be minor inconsistencies if master goes down before \nthe data is replicated which is very rare but worth calling out)",
      "autoResize": true,
      "lineHeight": 1.25
    },
