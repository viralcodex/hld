    {
      "id": "WWVNw5jPcXTCKlnGIFN_W",
      "type": "text",
      "x": -1169.2505040253186,
      "y": -155.63081716875718,
      "width": 599.6150566486094,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 328456081,
      "version": 832,
      "versionNonce": 638374769,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791547817134,
      "link": null,
      "locked": false,
      "text": "consistent hashing prevents\nrefactoring all the KV data if we add a new\nnode or some goes down. but there can be\na problem when all of the data between N1\nand N2 (N2 goes down), gets put in N3.\nThat's where virtual nodes come in,\nall the data in N2 gets distributed\nrandomly to these vnodes to prevent one\nnode from loading the dead's weight.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "consistent hashing prevents\nrefactoring all the KV data if we add a new node or some goes down. but there can be a problem when all of the data between N1 and N2 (N2 goes down), gets put in N3. That's where virtual nodes come in,\nall the data in N2 gets distributed randomly to these vnodes to prevent one node from loading the dead's weight.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "KaiNiNAXiTVYh8ZpQAzZR",
      "type": "text",
      "x": -767.1749372672955,
      "y": -599.4165885866908,
      "width": 761.543701171875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 318692625,
      "version": 364,
      "versionNonce": 352058879,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791547871254,
      "link": null,
      "locked": false,
      "text": "gossip protocol (p2p) keeps all nodes aware of other's\nstate, this is helpful in keeping sync and maintain a\ncluster-aware behaviour of the whole distributed cache.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gossip protocol (p2p) keeps all nodes aware of other's\nstate, this is helpful in keeping sync and maintain a\ncluster-aware behaviour of the whole distributed cache.",
      "autoResize": true,
      "lineHeight": 1.25
    },
